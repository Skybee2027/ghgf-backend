# ============================================
# GHGF AUTOMATION - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub (it's in .gitignore)

# ============================================
# TEXT GENERATION LAYER
# ============================================

# Groq API (Get from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Google Gemini API (Get from: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIz_your_key_here

# Cohere API (Get from: https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=your_cohere_key_here

# Together AI API (Get from: https://api.together.xyz/settings/keys)
TOGETHER_AI_API_KEY=your_together_key_here

# OpenAI API (Get from: https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-proj-your_key_here

# Buffer AI API (Get from: https://buffer.com/app/settings/integrations)
BUFFER_AI_API_KEY=your_buffer_ai_key_here

# Ollama Local (Run locally at http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# ============================================
# IMAGE GENERATION LAYER
# ============================================

# Replicate API (Get from: https://replicate.com/account/api-tokens)
REPLICATE_API_KEY=r8_your_key_here

# HuggingFace API (Get from: https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_your_token_here

# Unsplash API (Get from: https://unsplash.com/oauth/applications)
UNSPLASH_API_KEY=your_unsplash_key_here

# Pixabay API (Get from: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here

# DALLE API - SEPARATE KEY (Get from: https://platform.openai.com/account/api-keys)
DALLE_API_KEY=sk-proj-your_dalle_key_here

# ============================================
# CONTENT DISCOVERY LAYER
# ============================================

# Reddit API (Get from: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ============================================
# AFFILIATE NETWORKS LAYER
# ============================================

# CJ Affiliate API (Get from: https://api.cj.com/manage/manage-api-keys)
CJ_AFFILIATE_API_KEY=your_cj_key_here

# ShareASale API (Get from: https://www.shareasale.com/publishers)
SHAREASALE_API_TOKEN=your_shareasale_token_here
SHAREASALE_USER_ID=your_shareasale_user_id_here

# ============================================
# DISTRIBUTION LAYER
# ============================================

# Mailchimp API (Get from: https://mailchimp.com/account/api/)
MAILCHIMP_API_KEY=your_mailchimp_key_here

# Buffer Distribution API (Get from: https://buffer.com/settings/apps)
BUFFER_API_KEY=your_buffer_api_key_here

# ============================================
# WORDPRESS PUBLISHING (REQUIRED)
# ============================================

# Your WordPress blog URL (no trailing slash)
WORDPRESS_SITE_URL=https://yourblog.com

# WordPress admin username
WORDPRESS_USERNAME=admin

# WordPress Application Password (NOT your login password!)
# Create at: Admin Dashboard > Users > Your Profile > Application Passwords
WORDPRESS_PASSWORD=your_app_password_here
